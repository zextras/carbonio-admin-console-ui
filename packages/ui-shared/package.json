    "pnpm": "^10.15.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^12.3.1",
    "react-router": "^7.13.0",
    "react-router-dom": "^7.13.0",
    "ua-parser-js": "^1.0.41",
    "zod": "^4.3.6",
    "zustand": "^4.4.1"
