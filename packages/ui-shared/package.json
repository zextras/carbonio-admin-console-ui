    "eslint": "^9.39.4",
    "eslint-plugin-css-modules": "^2.12.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "playwright": "^1.61.1",
    "prop-types": "^15.8.1",
