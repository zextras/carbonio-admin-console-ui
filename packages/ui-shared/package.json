{
  "name": "@zextras/ui-shared",
  "description": "shared stores and utils for Carbonio Admin Panel",
  "private": true,
  "main": "./src/exports.ts",
  "types": "dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/exports.ts"
    }
  },
  "engines": {
    "node": "v22",
    "npm": "11.17.0"
  },
  "scripts": {
    "reset": "pnpm exec tsx ../../scripts/reset.ts",
