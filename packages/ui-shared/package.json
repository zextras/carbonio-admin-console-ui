    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.2.6",
    "vitest": "^4.1.0",
    "vitest-browser-react": "^2.1.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "zextras"
