    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.8",
    "react-router": "^7.13.0",
    "react-router-dom": "^7.13.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
