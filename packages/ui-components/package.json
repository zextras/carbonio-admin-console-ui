{
	"name": "@zextras/carbonio-design-system",
	"version": "0.0.0-semantically-released",
	"description": "An awesome UI for Zextras Projects.",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"type": "commonjs",
	"files": [
		"src",
		"package.json",
		"README.md",
		"COPYING",
		"CHANGELOG.md"
	],
	"scripts": {
		"release": "standard-version",
		"lint": "eslint src --ignore-pattern 'src/components/utilities/Transition.tsx'",
		"lint:icons": "eslint src/icons --fix",
		"test": "(is-ci && jest --runInBand) || jest --maxWorkers=50%",
		"icons:build": "tsc ./src/icons/tsTemplate.ts && npx @svgr/cli svg --template ./src/icons/tsTemplate.ts --out-dir ./src/icons && npm run lint:icons",
		"build": "echo 'No build needed - apps import TypeScript source directly'",
		"clean": "rm -rf dist/* types/*",
		"prepare": "is-ci || husky",
		"type-check": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zextras/carbonio-design-system.git"
	},
	"keywords": [
		"Zextras",
		"Carbonio",
		"ui",
		"DesignSystem"
	],
	"author": "Zextras Frontend Tribe <https://www.zextras.com/carbonio/>",
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/Zextras/carbonio-design-system",
	"sideEffects": false,
	"devDependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"@babel/core": "^7.23.9",
		"@babel/plugin-transform-runtime": "^7.23.9",
		"@babel/preset-env": "^7.23.9",
		"@babel/preset-react": "^7.23.3",
		"@babel/preset-typescript": "^7.23.3",
		"@commitlint/cli": "^19.2.2",
		"@commitlint/config-conventional": "^19.2.2",
		"@faker-js/faker": "^8.4.0",
		"@microsoft/api-extractor": "^7.43.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-commonjs": "^25.0.7",
		"@rollup/plugin-node-resolve": "^15.2.3",
		"@rollup/plugin-typescript": "^11.1.6",
		"@rollup/plugin-url": "^8.0.2",
		"@svgr/cli": "^8.0.1",
		"@testing-library/dom": "^10.3.2",
		"@testing-library/jest-dom": "^6.4.6",
		"@testing-library/react": "^16.0.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/jest": "^29.5.12",
		"@types/lodash": "^4.14.196",
		"@types/react": "^19.1.0",
		"@types/react-datepicker": "^4.15.0",
		"@types/react-dom": "^19.1.0",
		"@types/styled-components": "^5.1.26",
		"@zextras/carbonio-ui-configs": "^1.0.3",
		"babel-jest": "^29.7.0",
		"babel-loader": "^9.1.3",
		"babel-plugin-styled-components": "^2.1.4",
		"conventional-changelog-conventionalcommits": "^8.0.0",
		"create-index": "2.6.0",
		"del": "^7.1.0",
		"eslint-plugin-notice": "^0.9.10",
		"husky": "^9.0.7",
		"is-ci": "^3.0.1",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"jest-fail-on-console": "^3.1.2",
		"jest-junit": "^16.0.0",
		"jest-styled-components": "^7.2.0",
		"jsdom": "^24.0.0",
		"lodash": "^4.17.21",
		"process": "0.11.10",
		"react-docgen-typescript": "^2.2.2",
		"rollup": "^4.13.2",
		"semantic-release": "^24.0.0",
		"ts-node": "^10 >=10.9.2",
		"typescript": "^5.4.5"
	},
	"browserslist": [
		">1%",
		"last 3 version",
		"Firefox ESR",
		"not dead"
	],
	"peerDependencies": {
		"lodash": "^4.17.21",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"styled-components": "^5.3.11"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.5.3",
		"core-js": "^3.38.1",
		"darkreader": "^4.9.58",
		"polished": "^4.2.2",
		"react-datepicker": "^4.25.0"
	}
}
