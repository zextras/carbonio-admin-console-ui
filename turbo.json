{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build-webpack": {
			"dependsOn": ["^build-webpack"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", "build/**", "lib/**"]
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"type-check": {
			"dependsOn": ["^type-check"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"test:ci": {
			"dependsOn": ["^test:ci"]
		},

		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
