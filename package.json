{
  "name": "admin-ui",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "sdk build",
    "deploy": "sdk deploy",
    "start": "sdk watch",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "type-check": "tsc --noEmit",
    "type-check:watch": "pnpm run type-check -- --watch",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx apps/*/src",
    "lint-fix": "eslint --fix --ext .js,.jsx,.ts,.tsx --quiet",
    "lint-errors": "eslint --ext .js,.jsx,.ts,.tsx --quiet apps/*/src",
    "lint-stats": "eslint --ext .js,.jsx,.ts,.tsx --format node_modules/eslint-stats/byErrorAndWarningStacked apps/*/src",
    "lint-check": "pnpm run lint-errors; pnpm run type-check",
    "test": "TZ=Europe/Rome jest --testTimeout=20000 --maxWorkers=50%",
    "test:watch": "pnpm run test:dev -- --onlyChanged --watch",
    "sdk-setup": "pnpm ci --prefix sdk",
    "build:dev": "sdk build --dev --pkgRel $(date +%s)",
    "dev-deploy": "sdk build --dev --pkgRel $(date +%s) && sdk deploy"
  },
  "devDependencies": {
    "@babel/core": "^7.22.15",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.22.15",
    "@babel/preset-env": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.22.15",
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@eslint/js": "^9.34.0",
    "@faker-js/faker": "^8.0.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@tsconfig/recommended": "^1.0.10",
    "@types/jest": "^28.1.6",
    "@types/lodash": "^4.14.197",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-redux": "^7.1.25",
    "@types/react-router-dom": "^5.3.3",
    "@types/redux-logger": "3.0.9",
    "@types/styled-components": "^5.1.26",
    "@types/ua-parser-js": "^0.7.39",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@zextras/carbonio-ui-sdk": "^1.7.7",
    "babel-jest": "27.3.1",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-notice": "^0.9.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-testing-library": "^5.11.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "eslint-stats": "^1.0.1",
    "globals": "^16.3.0",
    "is-ci": "^3.0.1",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^29.6.4",
    "jest-fail-on-console": "^3.1.1",
    "jest-fetch-mock": "^3.0.3",
    "msw": "^1.3.0",
    "pinst": "^3.0.0",
    "pnpm": "^10.15.0",
    "turbo": "latest",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.3",
    "@types/react-csv": "^1.1.3",
    "@zextras/carbonio-design-system": "^8.1.0",
    "core-js": "^3.33.2",
    "darkreader": "^4.9.58",
    "dotenv": "^16.3.1",
    "history": "^5.3.0",
    "html-entities": "^2.6.0",
    "i18next": "^22.5.1",
    "immer": "^10.0.2",
    "jest-junit": "^16.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "path-browserify": "^1.0.1",
    "pnpm": "^10.15.0",
    "posthog-js": "^1.130.1",
    "prop-types": "^15.8.1",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-csv": "2.2.2",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.43.1",
    "react-i18next": "^12.3.1",
    "react-redux": "^8.1.2",
    "react-router-dom": "^5.3.4",
    "redux-logger": "3.0.6",
    "styled-components": "^5.3.11",
    "ua-parser-js": "^1.0.41",
    "uuid": "^9.0.0",
    "zustand": "^4.4.1"
  },
  "browserslist": [
    ">1%",
    "last 1 version",
    "Firefox ESR",
    "not dead"
  ],
  "carbonio": {
    "translations_repository": "git@github.com:Zextras/carbonio-admin-manage-ui-i18n.git",
    "name": "carbonio-admin-console-ui",
    "priority": 3,
    "type": "carbonioAdmin",
    "display": "Manage",
    "icon": "List"
  }
}
