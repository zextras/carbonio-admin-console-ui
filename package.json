{
	"name": "admin-ui",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@10.15.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"test:ci": "turbo run test:ci",
		"type-check": "turbo run type-check",
		"lint": "turbo run lint",
		"reset": "rm -rf node_modules apps/*/node_modules pnpm-lock.yaml .turbo && pnpm store prune --force && pnpm install"
	},
	"dependencies": {
		"react": "^19.1.0"
	},
	"devDependencies": {
		"@tsconfig/node12": "^12.1.4",
		"@typescript-eslint/eslint-plugin": "^8.41.0",
		"@vitejs/plugin-react": "^5.0.2",
		"@vitest/browser": "^3.2.4",
		"@vitest/coverage-istanbul": "^4.0.0",
		"depcheck": "^1.4.7",
		"eslint": "^9.34.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-notice": "^1.0.0",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-sonarjs": "^3.0.5",
		"eslint-plugin-testing-library": "^7.6.6",
		"eslint-plugin-unused-imports": "^4.2.0",
		"playwright": "^1.55.0",
		"pnpm": "^10.15.1",
		"turbo": "latest",
		"typescript": "^5.7.2",
		"vite-plugin-svgr": "^4.5.0",
		"vitest": "^3.2.4",
		"vitest-browser-react": "^1.0.1"
	},
	"browserslist": [
		">1%",
		"last 1 version",
		"Firefox ESR",
		"not dead"
	],
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"carbonio": {
		"translations_repository": "git@github.com:Zextras/carbonio-admin-manage-ui-i18n.git",
		"name": "carbonio-admin-console-ui",
		"priority": 3,
		"type": "carbonioAdmin",
		"display": "Manage",
		"icon": "List"
	}
}
