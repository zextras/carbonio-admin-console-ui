{
  "name": "admin-ui",
  "version": "0.0.0-semantically-released",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "build:unified": "node ./scripts/build_unified.js",
    "build:unified:dev": "node ./scripts/build_unified.js --dev",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "deploy:unified": "node ./scripts/deploy-unified.js",
    "test": "node scripts/test-runner.js",
    "test:ci": "turbo run test:ci",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "lint-fix": "turbo run lint-fix",
    "type-lint": "turbo run type-check && turbo run lint",
    "sonar:generate": "node scripts/generate-sonar-config.js",
    "reset": "node scripts/reset.js"
  },
  "dependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@tsconfig/node12": "^12.1.4",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser": "^4.0.5",
    "@vitest/browser-playwright": "^4.0.5",
    "@vitest/browser-preview": "^4.0.14",
    "@vitest/coverage-istanbul": "^4.0.5",
    "@vitest/ui": "^4.0.5",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-notice": "^1.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^7.6.6",
    "eslint-plugin-unused-imports": "^4.3.0",
    "knip": "^5.70.1",
    "playwright": "^1.55.0",
    "pnpm": "^10.15.1",
    "semantic-release": "^25.0.2",
    "turbo": "latest",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.49.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.14",
    "vitest-browser-react": "^2.0.2"
  },
  "browserslist": [
    ">1%",
    "last 1 version",
    "Firefox ESR",
    "not dead"
  ],
  "msw": {
    "workerDirectory": [
      "./packages/test-utils/public",
      "./apps/admin-ui-bootstrap/public",
      "./apps/admin-ui-console/public",
      "./apps/admin-ui-dashboard/public",
      "./apps/admin-ui-subscription/public",
      "./apps/admin-ui-domains/public",
      "./apps/admin-ui-privacy/public",
      "./apps/admin-ui-mta/public",
      "./apps/admin-ui-storage/public",
      "./apps/admin-ui-backup/public",
      "./apps/admin-ui-legalhold/public",
      "./apps/admin-ui-cos/public"
    ]
  },
  "carbonio": {
    "translations_repository": "git@github.com:Zextras/carbonio-admin-manage-ui-i18n.git",
    "name": "carbonio-admin-console-ui",
    "priority": 3,
    "type": "carbonioAdmin",
    "display": "Manage",
    "icon": "List"
  }
}
