#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Auto-generate sonar config if admin-ui directories changed
if git diff --cached --name-only | grep -E '^apps/admin-ui-|^packages/sdk'; then
    echo "🔍 Changes detected in admin-ui modules, regenerating Sonar configuration..."
    npm run sonar:generate
    git add sonar-project.properties
    echo "✅ Sonar configuration updated and staged"
fi
