{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,  // Required for references
    "declaration": true,  // Required for composite
    "declarationMap": true,
    "outDir": "./dist",  // Output directory
    "rootDir": "./src",
    "baseUrl": ".",
    "noEmit": false  // Must be false for composite projects
  },
  "include": [
    "src/**/*",
    "src/globals.d.ts",
    "types/**/*"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
