{
	"name": "@zextras/admin-ui-bootstrapper",
	"version": "0.9.36",
	"description": "The Zextras Carbonio web admin",
	"private": true,
	"main": "./exports.ts",
	"types": "./exports.ts",
	"engines": {
		"node": "v20",
		"npm": "v10"
	},
	"scripts": {
		"build": "sdk build --admin",
		"build:clean": "rm -rf lib && rm -rf dist && rm -rf pkg",
		"prepack": "npm run build:clean && npm run build -- -d",
		"postpublish": "rm -rf lib",
		"check-types": "tsc --noEmit",
		"type-check": "tsc --noEmit",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx --quiet",
		"lint-fix": "eslint --fix --ext .js,.jsx,.ts,.tsx --quiet",
		"build:lib:local": "tsc -p tsconfig.lib.json && npx api-extractor run --verbose --local",
		"deploy": "sdk deploy --admin",
		"start": "sdk watch --admin",
		"pull-translations": "git subtree pull -P translations git@github.com:Zextras/carbonio-admin-ui-i18n.git master --squash",
		"push-translations": "git subtree push -P translations git@github.com:Zextras/carbonio-admin-ui-i18n.git",
		"build:dev": "sdk build --dev --pkgRel $(date +%s) --admin",
		"test": "pnpm run test:unit && pnpm run test:browser",
		"test:unit": "vitest run --project=unit --passWithNoTests",
		"test:browser": "vitest run --project=browser --passWithNoTests",
		"test:all": "vitest run",
		"test:watch": "vitest --project=unit",
		"test:watch:browser": "vitest --browser --watch --ui --open",
		"test:coverage": "vitest run --project=unit --coverage",
		"test:ci": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:debug": "vitest --project=browser --browser.headless=false"
	},
	"dependencies": {
		"@fontsource/roboto": "^5.2.6",
		"@reduxjs/toolkit": "^1.9.3",
		"@sentry/browser": "^6.17.7",
		"@tinymce/tinymce-react": "^4.3.2",
		"@zextras/carbonio-design-system": "^8.1.0",
		"darkreader": "^4.9.58",
		"date-fns": "^4.1.0",
		"history": "^5.3.0",
		"i18next": "^22.5.1",
		"i18next-http-backend": "^2.5.0",
		"immer": "^10.0.2",
		"lodash": "^4.17.21",
		"moment": "^2.29.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^12.3.1",
		"react-markdown": "^10.1.0",
		"react-redux": "^8.1.2",
		"react-router-dom": "^5.3.4",
		"redux": "^5.0.1",
		"redux-logger": "3.0.6",
		"remark-gfm": "^4.0.1",
		"styled-components": "^5.3.11",
		"tinymce": "^6.8.4",
		"ua-parser-js": "^1.0.41",
		"zustand": "^4.4.1"
	},
	"devDependencies": {
		"@babel/core": "^7.22.15",
		"@babel/preset-env": "^7.22.15",
		"@babel/preset-react": "^7.22.15",
		"@babel/preset-typescript": "^7.22.15",
		"@eslint/js": "^9.34.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-commonjs": "^28.0.6",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@svgr/webpack": "^8.1.0",
		"@testing-library/react": "^16.0.1",
		"@types/lodash": "^4.14.197",
		"@types/node": "^20.17.27",
		"@types/prop-types": "^15.7.15",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@types/react-redux": "^7.1.25",
		"@types/react-router-dom": "^5.3.3",
		"@types/redux-logger": "3.0.9",
		"@types/styled-components": "^5.1.26",
		"@types/ua-parser-js": "^0.7.39",
		"@types/webpack-env": "^1.18.8",
		"@vitejs/plugin-react": "^5.0.2",
		"@vitest/browser": "^3.2.4",
		"admin-ui-sdk": "workspace:*",
		"autoprefixer": "^10.4.21",
		"babel-plugin-i18next-extract": "^1.1.0",
		"babel-plugin-styled-components": "^2.1.4",
		"copy-webpack-plugin": "^13.0.1",
		"eslint": "^9.34.0",
		"html-webpack-plugin": "^5.6.4",
		"is-ci": "^3.0.1",
		"jsdom": "^26.1.0",
		"playwright": "^1.55.0",
		"pnpm": "^10.15.1",
		"prop-types": "^15.8.1",
		"turbo": "latest",
		"typescript": "^5.7.2",
		"vitest": "^3.2.4",
		"vitest-browser-react": "^1.0.1",
		"webpack": "^5.101.3"
	},
	"files": [
		"dist/",
		"README.md"
	],
	"keywords": [
		"zextras"
	],
	"author": "Zextras NP Team <https://www.zextras.com/carbonio/>",
	"maintainers": [],
	"license": "AGPL-3.0-only",
	"sdk": {
		"svgr": true
	},
	"carbonio": {
		"name": "carbonio-admin-ui",
		"translations_repository": "git@bitbucket.org:zextras/admin-ui.git",
		"type": "shell",
		"priority": -1,
		"display": "Admin Shell",
		"icon": "CubeOutline"
	}
}
