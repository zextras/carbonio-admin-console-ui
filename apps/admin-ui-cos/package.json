{
  "name": "@zextras/admin-ui-cos",
  "private": true,
  "version": "0.10.9",
  "description": "Cos module for Zextras Carbonio Admin Panel",
  "main": "src/app.tsx",
  "scripts": {
    "build": "node ../../packages/sdk/scripts/vite/build.mjs",
    "build:vite": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx --quiet",
    "lint-fix": "eslint --fix --ext .js,.jsx,.ts,.tsx --quiet",
    "lint-errors": "eslint --ext .js,.jsx,.ts,.tsx --quiet",
    "lint-stats": "eslint --ext .js,.jsx,.ts,.tsx --format node_modules/eslint-stats/byErrorAndWarningStacked",
    "lint-check": "pnpm run lint-errors; pnpm run type-check",
    "test": "pnpm run test:unit && pnpm run test:browser",
    "test:unit": "vitest run --project=unit --passWithNoTests",
    "test:browser": "vitest run --project=browser --passWithNoTests",
    "test:all": "vitest run",
    "test:watch": "vitest --project=unit",
    "test:watch:browser": "vitest --browser --watch",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:ci": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:debug": "vitest --project=browser --browser.headless=false",
    "build:dev": "node ../../packages/sdk/scripts/vite/build.mjs --dev --pkgRel=$(date +%s)"
  },
  "dependencies": {
    "@zextras/admin-ui-bootstrap": "workspace:*",
    "@zextras/carbonio-design-system": "^8.1.0",
    "history": "^5.3.0",
    "i18next": "^22.5.1",
    "immer": "^10.1.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "posthog-js": "^1.261.0",
    "react": "^19.1.0",
    "react-i18next": "^12.3.1",
    "react-router-dom": "^5.3.4",
    "styled-components": "^5.3.11",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.22.15",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.22.15",
    "@babel/preset-env": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.22.15",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash": "^4.14.197",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^19.1.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.26",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser": "^3.2.4",
    "@vitest/ui": "3.2.4",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.34.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.0",
    "path-browserify": "^1.0.1",
    "pinst": "^3.0.0",
    "playwright": "^1.55.0",
    "pnpm": "^10.15.1",
    "react-dom": "^19.1.0",
    "turbo": "latest",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4",
    "vitest-browser-react": "^1.0.1",
    "webpack": "^5.101.3"
  },
  "keywords": [],
  "author": "Zextras NP Team <https://www.zextras.com/carbonio/>",
  "maintainers": [],
  "license": "AGPL-3.0-only",
  "carbonio": {
    "translations_repository": "git@github.com:Zextras/carbonio-admin-manage-ui-i18n.git",
    "name": "carbonio-admin-cos",
    "priority": 3,
    "type": "carbonioAdmin",
    "display": "Manage",
    "icon": "List"
  },
  "msw": {
    "workerDirectory": [
      "./public",
      "public"
    ]
  }
}