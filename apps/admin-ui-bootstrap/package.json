  "author": "Zextras NP Team <https://www.zextras.com/carbonio/>",
  "maintainers": [],
  "license": "AGPL-3.0-only",
  "carbonio": {
    "name": "carbonio-admin-ui",
    "translations_repository": "git@github.com:Zextras/carbonio-admin-manage-ui-i18n.git",
    "type": "shell",
    "priority": -1,
    "display": "Admin Shell",
    "icon": "CubeOutline"
  },
  "msw": {
    "workerDirectory": [
      "./public",
      "public"
    ]
  }
}
