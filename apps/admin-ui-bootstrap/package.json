{
  "name": "@zextras/admin-ui-bootstrap",
  "version": "0.9.36",
  "description": "The Zextras Carbonio web admin",
  "private": true,
  "engines": {
    "node": "v22",
    "npm": "v10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode='development'",
    "reset": "pnpm exec tsx ../../scripts/reset.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache --quiet",
    "lint:fix": "eslint --fix --quiet --cache",
    "test": "vitest run",
    "test:watch": "vitest --browser --watch --open",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@posthog/react": "^1.10.3",
    "@tanstack/react-query": "^5.90.5",
    "@zextras/admin-ui-backup": "workspace:*",
    "@zextras/admin-ui-cos": "workspace:*",
    "@zextras/admin-ui-dashboard": "workspace:*",
    "@zextras/admin-ui-domains": "workspace:*",
    "@zextras/admin-ui-legalhold": "workspace:*",
    "@zextras/admin-ui-mta": "workspace:*",
    "@zextras/admin-ui-notifications": "workspace:*",
    "@zextras/admin-ui-operations": "workspace:*",
    "@zextras/admin-ui-privacy": "workspace:*",
    "@zextras/admin-ui-storage": "workspace:*",
    "@zextras/admin-ui-subscription": "workspace:*",
    "@zextras/ui-components": "workspace:*",
    "@zextras/ui-shared": "workspace:*",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.1",
    "i18next-http-backend": "^4.0.0",
    "immer": "^11.1.8",
    "lodash-es": "^4.17.21",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.8",
    "react-router": "^7.13.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/react": "^16.3.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.4",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-preview": "^4.1.0",
    "@vitest/coverage-istanbul": "^4.1.0",
    "admin-ui-test-utils": "workspace:*",
    "babel-plugin-i18next-extract": "^1.1.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-css-modules": "^2.12.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "playwright": "^1.61.1",
    "prop-types": "^15.8.1",
    "sonarqube-scanner": "^4.3.8",
