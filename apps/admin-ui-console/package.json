		"pinst": "^3.0.0"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^1.9.3",
		"@types/react-csv": "^1.1.3",
		"@zextras/carbonio-design-system": "^8.1.0",
		"@zextras/admin-ui-bootstrapper": "workspace:*",
		"core-js": "^3.33.2",
		"history": "^5.3.0",
		"html-entities": "^2.6.0",
		"i18next": "^22.5.1",
		"immer": "^10.0.2",
		"jest-junit": "^16.0.0",
