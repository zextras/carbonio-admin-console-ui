{
	"name": "@zextras/admin-ui-console",
	"private": true,
	"version": "0.10.8",
	"description": "Admin module for Zextras Carbonio",
	"main": "src/app.tsx",
	"scripts": {
		"build": "turbo run build-task",
		"build-task": "sdk build",
		"deploy": "sdk deploy",
		"start": "sdk watch",
		"prepublishOnly": "pinst --disable",
		"postpublish": "pinst --enable",
		"type-check-task": "tsc --noEmit",
		"type-check": "turbo run type-check-task",
		"lint": "turbo run lint-task",
		"lint-task": "eslint --ext .js,.jsx,.ts,.tsx --quiet",
		"lint-fix": "eslint --fix --ext .js,.jsx,.ts,.tsx --quiet --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs",
		"lint-errors": "eslint --ext .js,.jsx,.ts,.tsx --quiet --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs src",
		"lint-stats": "eslint --ext .js,.jsx,.ts,.tsx --format node_modules/eslint-stats/byErrorAndWarningStacked --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs src",
		"lint-check": "pnpm run lint-errors; pnpm run type-check",
		"test": "vitest",
		"test:unit": "vitest run --project=unit",
		"test:browser": "vitest run --project=browser",
		"test:all": "vitest run",
		"test:watch": "vitest --project=unit",
		"test:watch:browser": "vitest --project=browser",
		"test:coverage": "vitest run --project=unit --coverage",
		"test:ci": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:debug": "vitest --project=browser --browser.headless=false",
		"sdk-setup": "pnpm ci --prefix sdk",
		"build:dev": "sdk build --dev --pkgRel $(date +%s)",
		"dev-deploy": "sdk build --dev --pkgRel $(date +%s) && sdk deploy"
	},
	"dependencies": {
		"@types/react-csv": "^1.1.10",
		"@zextras/admin-ui-bootstrapper": "workspace:*",
		"@zextras/carbonio-design-system": "^8.1.0",
		"history": "^5.3.0",
		"html-entities": "^2.6.0",
		"i18next": "^22.5.1",
		"immer": "^10.1.3",
		"lodash": "^4.17.21",
		"moment": "^2.30.1",
		"posthog-js": "^1.261.0",
		"qrcode.react": "^3.1.0",
		"react": "^18.3.1",
		"react-csv": "^2.2.2",
		"react-i18next": "^12.3.1",
		"react-router-dom": "^5.3.4",
		"styled-components": "^5.3.11",
		"zustand": "^4.5.7"
	},
	"devDependencies": {
		"@babel/core": "^7.22.15",
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-transform-runtime": "^7.22.15",
		"@babel/preset-env": "^7.22.15",
		"@babel/preset-react": "^7.22.15",
		"@babel/preset-typescript": "^7.22.15",
		"@eslint/js": "^9.34.0",
		"@testing-library/react": "^16.0.1",
		"@testing-library/user-event": "^14.5.2",
		"@types/lodash": "^4.14.197",
		"@types/react": "^18.3.11",
		"@types/react-dom": "^18.3.0",
		"@types/react-router-dom": "^5.3.3",
		"@types/styled-components": "^5.1.26",
		"@vitejs/plugin-react": "^5.0.2",
		"@vitest/browser": "^3.2.4",
		"@zextras/admin-ui-sdk": "workspace:*",
		"babel-plugin-styled-components": "^2.1.4",
		"eslint": "^9.34.0",
		"msw": "^1.3.0",
		"pinst": "^3.0.0",
		"playwright": "^1.55.0",
		"pnpm": "^10.15.1",
		"react-dom": "^18.3.1",
		"turbo": "latest",
		"typescript": "^5.7.2",
		"vitest": "^3.2.4",
		"vitest-browser-react": "^1.0.1",
		"webpack": "^5.101.3"
	},
	"keywords": [],
	"author": "Zextras NP Team <https://www.zextras.com/carbonio/>",
	"maintainers": [],
	"license": "AGPL-3.0-only",
	"carbonio": {
		"translations_repository": "git@github.com:Zextras/carbonio-admin-manage-ui-i18n.git",
		"name": "carbonio-admin-console-ui",
		"priority": 3,
		"type": "carbonioAdmin",
		"display": "Manage",
		"icon": "List"
	}
}
