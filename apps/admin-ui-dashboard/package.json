{
	"name": "@zextras/admin-ui-dashboard",
	"private": true,
	"version": "0.10.9",
	"description": "Admin dashboard module for Zextras Carbonio",
	"main": "src/app.tsx",
	"scripts": {
		"build": "sdk build",
		"build:dev": "sdk build --dev",
		"build:esm": "vite build --config vite.config.esm.ts && node postbuild-esm.mjs",
		"build:esm:dev": "vite build --config vite.config.esm.ts --mode development && node postbuild-esm.mjs",
		"deploy": "npm run build && sdk deploy",
		"deploy:dev": "npm run build:dev && sdk deploy",
		"start": "sdk watch",
		"type-check": "tsc --noEmit",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx --quiet",
		"test": "vitest run",
		"test:watch": "vitest --browser --watch --open",
		"test:ci": "vitest run --coverage"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.90.5",
		"@types/react-csv": "^1.1.10",
		"@zextras/admin-ui-bootstrap": "workspace:*",
		"@zextras/carbonio-design-system": "^8.1.0",
		"history": "^5.3.0",
		"html-entities": "^2.6.0",
		"i18next": "^22.5.1",
		"immer": "^10.1.3",
		"lodash": "^4.17.21",
		"moment": "^2.30.1",
		"pnpm": "^10.15.1",
		"posthog-js": "^1.261.0",
		"qrcode.react": "^3.1.0",
		"react": "^19.1.0",
		"react-csv": "^2.2.2",
		"react-i18next": "^12.3.1",
		"react-router-dom": "^5.3.4",
		"styled-components": "^5.3.11",
		"zustand": "^4.5.7"
	},
	"devDependencies": {
		"@babel/core": "^7.22.15",
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-transform-runtime": "^7.22.15",
		"@babel/preset-env": "^7.22.15",
		"@babel/preset-react": "^7.22.15",
		"@babel/preset-typescript": "^7.22.15",
		"@tanstack/react-query-devtools": "^5.90.2",
		"@testing-library/react": "^16.0.1",
		"@types/lodash": "^4.14.197",
		"@types/react": "^18.3.11",
		"@types/react-dom": "^19.1.0",
		"@types/react-router-dom": "^5.3.3",
		"@types/styled-components": "^5.1.26",
		"@vitest/browser": "^4.0.5",
		"@vitest/coverage-istanbul": "^4.0.5",
		"@vitest/ui": "^4.0.5",
		"admin-ui-sdk": "workspace:*",
		"admin-ui-test-utils": "workspace:*",
		"babel-plugin-styled-components": "^2.1.4",
		"eslint": "^9.34.0",
		"jsdom": "^26.1.0",
		"msw": "^1.3.0",
		"playwright": "^1.55.0",
		"react-dom": "^19.1.0",
		"typescript": "^5.7.2",
		"vitest": "^4.0.5",
		"vitest-browser-react": "^2.0.2"
	},
	"keywords": [],
	"author": "Zextras NP Team <https://www.zextras.com/carbonio/>",
	"maintainers": [],
	"license": "AGPL-3.0-only",
	"carbonio": {
		"translations_repository": "git@github.com:Zextras/carbonio-admin-manage-ui-i18n.git",
		"name": "carbonio-admin-dashboard-ui",
		"priority": 3,
		"type": "carbonioAdmin",
		"display": "Manage",
		"icon": "List"
	},
	"msw": {
		"workerDirectory": "public"
	}
}
