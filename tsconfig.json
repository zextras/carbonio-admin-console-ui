{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": [
        "apps/admin-ui-console/src/*",
        "apps/admin-ui-bootstrapper/src/*"
      ]
    }
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": [
    "src",
    "./apps/admin-ui-bootstrapper/src/*.ts",
    "./apps/admin-ui-bootstrapper/src/globals.d.ts",
    "./apps/admin-ui-bootstrapper/types/index.d.ts",
    "./apps/admin-ui-console/src/*.ts",
    "./apps/admin-ui-console/types/i18next.d.ts",
    "./apps/admin-ui-console/types/index.d.ts",
    "./apps/*/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
