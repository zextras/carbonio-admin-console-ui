{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true,
    "noImplicitOverride": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "noUncheckedIndexedAccess": false,
    "preserveSymlinks": true, // IMPORTANT for pnpm!
    "baseUrl": ".",
    "paths": {
      "@zextras/carbonio-design-system": [
        "node_modules/@zextras/carbonio-design-system",
        "apps/*/node_modules/@zextras/carbonio-design-system"
      ]
    }
  },
  "ts-node": {
    "transpileOnly": true
  },
  "moduleResolution": "node16", // or "nodenext" - better for pnpm
  "preserveSymlinks": false, // Try false if true doesn't work
  "resolvePackageJsonExports": true,
  "resolvePackageJsonImports": true,
  "include": ["./apps/**/src/**/*", "./apps/**/types/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
