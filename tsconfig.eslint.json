{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "**/*.js",
    "**/*.jsx",
    "apps/**/*",
    "scripts/**/*",
    "packages/**/*"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/build", "**/.turbo"]
}
