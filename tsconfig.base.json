{
  "extends": "@tsconfig/vite-react",
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "noUncheckedSideEffectImports": false,
    "noUnusedParameters": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "allowSyntheticDefaultImports": true,
    "preserveConstEnums": true,
    "noUncheckedIndexedAccess": false,
    "types": ["@vitest/browser/matchers", "vitest/globals"],
    "useDefineForClassFields": false,
    "plugins": [
      {
        "name": "typescript-plugin-css-modules",
        "options": {
          "classnameTransform": "camelCaseOnly"
        }
      }
    ]
  },
  "references": [
    { "path": "./packages/test-utils/" },
    { "path": "./packages/ui-i18n/" },
    { "path": "./packages/ui-components/" },
    { "path": "./packages/ui-shared/" },
    { "path": "./apps/admin-ui-backup/" },
    { "path": "./apps/admin-ui-cos/" },
    { "path": "./apps/admin-ui-dashboard/" },
    { "path": "./apps/admin-ui-domains/" },
    { "path": "./apps/admin-ui-legalhold/" },
    { "path": "./apps/admin-ui-mta/" },
    { "path": "./apps/admin-ui-notifications/" },
    { "path": "./apps/admin-ui-operations/" },
    { "path": "./apps/admin-ui-privacy/" },
    { "path": "./apps/admin-ui-storage/" },
    { "path": "./apps/admin-ui-subscription/" }
  ]
}
